generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               Int             @id @default(autoincrement())
  email            String          @unique
  name             String?
  password         String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  emailVerified    DateTime?
  image            String?
  accounts         Account[]
  aiUsages         AIUsage[]
  publicCharacters Character[]     @relation("CharacterCreator")
  notifications    Notification[]
  projects         NovelProject[]
  sessions         Session[]
  quota            UserQuota?
  virtualWriters   VirtualWriter[]
  styleProfiles    StyleProfile[]

  @@map("users")
}

model Account {
  id                Int     @id @default(autoincrement())
  userId            Int
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           Int      @id @default(autoincrement())
  sessionToken String   @unique
  userId       Int
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model AIModelConfig {
  id                   Int            @id @default(autoincrement())
  name                 String
  vendor               AIVendor
  modelId              String
  apiKey               String?
  apiEndpoint          String?
  isDefault            Boolean        @default(false)
  sortOrder            Int            @default(0)
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  embeddingModelId     String?
  embeddingDimensions  Int?
  embeddingVendor      AIVendor?
  embeddingApiKey      String?
  embeddingApiEndpoint String?
  projects             NovelProject[]

  @@index([isDefault])
  @@map("ai_model_configs")
}

model NovelProject {
  id                 Int                      @id @default(autoincrement())
  title              String
  description        String?
  genre              String?
  writingStyle       String?
  targetWordCount    Int?
  currentWordCount   Int                      @default(0)
  chapterWordCount   Int                      @default(3000)
  outline            String?
  outlineStages      Json?
  worldSetting       String?
  powerSystem        String?
  protagonistProfile String?
  protagonistGoal    String?
  antagonistSetting  String?
  endingPlan         String?
  writingPrompt      String?
  status             ProjectStatus            @default(DRAFT)
  coverImage         String?
  totalVolumes       Int                      @default(4)
  styleProfileId  String?
  styleStrength   Float    @default(0.5)
  styleSafetyMode String   @default("SAFE_ABSTRACT")
  aiModelId          Int?
  creatorId          Int
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt
  projectMode        String                   @default("CREATE")
  targetAudience     String?
  storyType          String                   @default("LONG")
  conflictIntensity  Float                    @default(0.5)
  corePitch          String?
  darkness           Float                    @default(0.3)
  humor              Float                    @default(0.3)
  lengthType         LengthType?
  mysteryDensity     Float                    @default(0.3)
  pace               Float                    @default(0.5)
  pipelineJobId      Int?
  workflowStage      String                   @default("BLUEPRINT_CONFIRM")
  blueprintConfirmedAt DateTime?
  arcPlanConfirmedAt DateTime?
  platform           Platform?
  powerGrowth        Float                    @default(0.5)
  romance            Float                    @default(0.2)
  agentLogs          AgentLog[]
  aiUsages           AIUsage[]
  analysisTasks      AnalysisTask[]
  arcPlans           ArcPlan[]
  arcEventLedger     ArcEventLedger[]
  chapterCompletionReports ChapterCompletionReport[]
  cheatAbilityState  CheatAbilityState?
  bookAnalyses       BookAnalysis[]
  bookBlueprint      BookBlueprint?
  bookSummary        BookSummary?
  chapterGraphSnapshot ChapterGraphSnapshot?
  chapterCommits     ChapterCommit[]
  chapterSummaries   ChapterSummary[]
  characters         Character[]
  coverDesigns       CoverDesign[]
  pipelineJobs       GenerationJob[]
  chapters           NovelChapter[]
  aiModelConfig      AIModelConfig?           @relation(fields: [aiModelId], references: [id], onDelete: SetNull)
  creator            User                     @relation(fields: [creatorId], references: [id], onDelete: Restrict)
  plotlines          Plotline[]
  maintenanceTasks   ProjectMaintenanceTask[]
  researchRefs       ResearchRef[]
  reviewReports      ReviewReport[]
  shortStory         ShortStory?
  sourceNovel        SourceNovel?
  storyEvents        StoryEvent[]
  storyState         StoryState?
  styleProfile       StyleProfile?             @relation(fields: [styleProfileId], references: [id])
  villains           Villain[]
  volumeSummaries    VolumeSummary[]
  worldState         WorldState?

  @@index([creatorId])
  @@index([status])
  @@index([creatorId, status])
  @@index([pipelineJobId])
  @@index([workflowStage])
  @@index([styleProfileId])
  @@index([projectMode])
  @@index([createdAt])
  @@map("novel_projects")
}

model NovelChapter {
  id                Int              @id @default(autoincrement())
  projectId         Int
  chapterNumber     Int
  title             String
  content           String?
  summary           String?
  wordCount         Int              @default(0)
  generationPrompt  String?
  generationParams  Json?
  generationCount   Int              @default(0)
  lastGeneratedTime DateTime?
  sortOrder         Int              @default(0)
  status            ChapterStatus    @default(DRAFT)
  virtualWriterId   Int?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  chapterOutline    Json?
  lastAgentType     AgentType?
  retryCount        Int              @default(0)
  validationReport  Json?
  completionReport  Json?
  chapterCommits    ChapterCommit[]
  versions          ChapterVersion[]
  project           NovelProject     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  virtualWriter     VirtualWriter?   @relation(fields: [virtualWriterId], references: [id])

  @@unique([projectId, chapterNumber])
  @@index([projectId])
  @@index([projectId, status])
  @@index([status])
  @@map("novel_chapters")
}

model ChapterCommit {
  id               String        @id @default(cuid())
  projectId        Int
  chapterId        Int?
  chapterNo        Int
  source           String        @default("pipeline")
  status           String        @default("accepted")
  payload          Json          @default("{}")
  projectionStatus Json          @default("{}")
  replayCount      Int           @default(0)
  appliedAt        DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  chapter          NovelChapter? @relation(fields: [chapterId], references: [id])
  project          NovelProject  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([projectId, chapterNo])
  @@index([status])
  @@map("chapter_commits")
}

model VirtualWriter {
  id                 Int              @id @default(autoincrement())
  name               String
  description        String?
  writerType         WriterType       @default(CUSTOM)
  styleFeatures      String?
  vocabularyFeatures String?
  sentenceFeatures   String?
  rhetoricFeatures   String?
  themeFeatures      String?
  trainingStatus     TrainingStatus   @default(UNTRAINED)
  trainingProgress   Int              @default(0)
  trainedAt          DateTime?
  documentCount      Int              @default(0)
  totalWordCount     Int              @default(0)
  isPublic           Boolean          @default(false)
  tags               String?
  creatorId          Int
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  chapters           NovelChapter[]
  creator            User             @relation(fields: [creatorId], references: [id])
  documents          WriterDocument[]
  styleProfiles      StyleProfile[]

  @@index([creatorId])
  @@index([isPublic])
  @@index([trainingStatus])
  @@map("virtual_writers")
}

model WriterDocument {
  id              Int            @id @default(autoincrement())
  virtualWriterId Int
  fileName        String
  filePath        String
  fileSize        Int
  wordCount       Int
  status          DocumentStatus @default(PENDING)
  errorMessage    String?
  createdAt       DateTime       @default(now())
  processedAt     DateTime?
  virtualWriter   VirtualWriter  @relation(fields: [virtualWriterId], references: [id], onDelete: Cascade)

  @@index([virtualWriterId])
  @@index([status])
  @@map("writer_documents")
}

model ChapterVersion {
  id            Int          @id @default(autoincrement())
  chapterId     Int
  content       String
  wordCount     Int
  prompt        String?
  versionNumber Int
  createdAt     DateTime     @default(now())
  chapter       NovelChapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  @@index([chapterId])
  @@map("chapter_versions")
}

model BookAnalysis {
  id           String       @id @default(cuid())
  projectId    Int
  volumeNumber Int          @default(-1)
  analysisType String
  dimension    String
  analysisData Json
  rawContent   String?
  wordCount    Int?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  project      NovelProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, volumeNumber, analysisType, dimension])
  @@index([projectId])
  @@map("book_analysis")
}

model ChapterGraphSnapshot {
  id             String       @id @default(cuid())
  projectId      Int          @unique
  graph          Json         @default("{}")
  sourceUpdatedAt DateTime?
  generatedAt    DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  project        NovelProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("chapter_graph_snapshots")
}

model AnalysisTask {
  id                  String             @id @default(cuid())
  projectId           Int
  volumeNumber        Int                @default(-1)
  dimensions          Json
  contextChapterCount Int                @default(3)
  status              AnalysisTaskStatus @default(PENDING)
  progress            Int                @default(0)
  progressMessage     String?
  totalDimensions     Int
  completedDimensions Int                @default(0)
  currentDimension    String?
  errorMessage        String?
  startedAt           DateTime?
  completedAt         DateTime?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  project             NovelProject       @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([projectId, status])
  @@index([projectId, createdAt(sort: Desc)])
  @@map("analysis_tasks")
}

model SourceNovel {
  id           String         @id @default(cuid())
  projectId    Int            @unique
  originalText String
  wordCount    Int
  sourceName   String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  project      NovelProject   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  styleProfiles StyleProfile[]

  @@map("source_novels")
}

model StyleProfile {
  id              String             @id @default(cuid())
  name            String
  description     String?
  sourceType      String             @default("USER_UPLOADED")
  riskLevel       String             @default("MEDIUM")
  authorLabel     String?
  displayLabel    String
  profileJson     Json
  promptCard      String?            @db.Text
  sampleStats     Json?
  sourceNovelId   String?
  virtualWriterId Int?
  creatorId       Int
  isPublic        Boolean            @default(false)
  tags            String[]           @default([])
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  projects        NovelProject[]
  creator         User               @relation(fields: [creatorId], references: [id])
  sourceNovel     SourceNovel?        @relation(fields: [sourceNovelId], references: [id])
  virtualWriter   VirtualWriter?      @relation(fields: [virtualWriterId], references: [id])

  @@index([creatorId])
  @@index([sourceType])
  @@index([isPublic])
  @@map("style_profiles")
}

model Character {
  id            String        @id @default(cuid())
  projectId     Int
  name          String
  role          CharacterRole @default(SUPPORTING)
  aliases       String[]      @default([])
  appearance    String?
  personality   String?
  catchphrases  String[]      @default([])
  background    String?
  relationships Json?         @default("{}")
  currentState  Json?         @default("{}")
  firstChapter  Int?
  lastUpdated   Int?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  creatorId     Int?
  isPublic      Boolean       @default(false)
  tags          String[]      @default([])
  speechStyle      String?
  vocabularyLevel  String?
  sentencePattern  String?
  catchphraseStyle String?
  dialogueExamples String[]    @default([])
  voiceNotes       String?
  creator       User?         @relation("CharacterCreator", fields: [creatorId], references: [id])
  project       NovelProject  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([creatorId])
  @@index([name])
  @@index([role])
  @@map("characters")
}

model Plotline {
  id          String         @id @default(cuid())
  projectId   Int
  type        PlotlineType   @default(FORESHADOW)
  description String
  plantedAt   Int
  resolvedAt  Int?
  plannedAt   Int?
  status      PlotlineStatus @default(OPEN)
  metadata    Json?          @default("{}")
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  project     NovelProject   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([status])
  @@index([projectId, status, plantedAt])
  @@index([type])
  @@map("plotlines")
}

model StoryState {
  id                      String       @id @default(cuid())
  projectId               Int          @unique
  emotionalArc            Json         @default("[]")
  emotionalArcSummaries   Json?        @default("[]")
  mainConflict            String?
  subConflicts            Json?        @default("[]")
  currentChapter          Int          @default(0)
  totalPlanned            Int          @default(100)
  metadata                Json?        @default("{}")
  createdAt               DateTime     @default(now())
  updatedAt               DateTime     @updatedAt
  project                 NovelProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("story_states")
}

model StoryEvent {
  id          String       @id @default(cuid())
  projectId   Int
  eventType   String
  chapterNo   Int?
  description String
  metadata    Json?        @default("{}")
  createdAt   DateTime     @default(now())
  project     NovelProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([chapterNo])
  @@index([projectId, createdAt])
  @@index([eventType])
  @@map("story_events")
}

model AgentLog {
  id               String       @id @default(cuid())
  projectId        Int
  chapterNo        Int
  agentType        AgentType
  status           String
  inputPrompt      String?
  outputContent    String?
  errorMessage     String?
  tokenCount       Int?
  durationMs       Int?
  validationResult Json?        @default("{}")
  createdAt        DateTime     @default(now())
  project          NovelProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, chapterNo])
  @@index([createdAt])
  @@index([agentType])
  @@index([status])
  @@map("agent_logs")
}

model ChapterSummary {
  id                String       @id @default(cuid())
  projectId         Int
  chapterNo         Int
  summary           String
  keyEvents         String[]     @default([])
  emotionalTone     String?
  plantedPlotlines  String[]     @default([])
  resolvedPlotlines String[]     @default([])
  createdAt         DateTime     @default(now())
  project           NovelProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, chapterNo])
  @@index([projectId])
  @@map("chapter_summaries")
}

model VolumeSummary {
  id                String       @id @default(cuid())
  projectId         Int
  volumeNumber      Int
  summary           String
  keyEvents         String[]     @default([])
  emotionalArc      Json         @default("[]")
  plantedPlotlines  String[]     @default([])
  resolvedPlotlines String[]     @default([])
  chapterOverview   Json         @default("[]")
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  project           NovelProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, volumeNumber])
  @@index([projectId])
  @@map("volume_summaries")
}

model BookSummary {
  id                String       @id @default(cuid())
  projectId         Int          @unique
  summary           String
  mainPlot          String
  subPlots          String[]     @default([])
  characterArcs     Json         @default("[]")
  thematicElements  String[]     @default([])
  totalPlotlines    Int          @default(0)
  resolvedPlotlines Int          @default(0)
  openPlotlines     Int          @default(0)
  structureAnalysis Json?        @default("{}")
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  project           NovelProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("book_summaries")
}

model Notification {
  id        Int                  @id @default(autoincrement())
  userId    Int
  type      NotificationType     @default(SYSTEM)
  priority  NotificationPriority @default(NORMAL)
  title     String
  content   String
  link      String?
  isRead    Boolean              @default(false)
  projectId Int?
  metadata  Json?                @default("{}")
  createdAt DateTime             @default(now())
  readAt    DateTime?
  user      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([userId, createdAt])
  @@index([createdAt])
  @@map("notifications")
}

model ModelPricing {
  id          Int      @id @default(autoincrement())
  vendor      AIVendor
  modelId     String
  inputPrice  Decimal
  outputPrice Decimal
  currency    String   @default("CNY")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([vendor, modelId])
  @@map("model_pricings")
}

model UserQuota {
  id             Int      @id @default(autoincrement())
  userId         Int      @unique
  monthlyLimit   Decimal
  alertThreshold Decimal
  isLocked       Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_quotas")
}

model AIUsage {
  id               String        @id @default(cuid())
  userId           Int
  projectId        Int?
  vendor           AIVendor
  modelId          String
  usageType        String
  promptTokens     Int           @default(0)
  completionTokens Int           @default(0)
  totalTokens      Int           @default(0)
  inputCost        Decimal       @default(0)
  outputCost       Decimal       @default(0)
  totalCost        Decimal       @default(0)
  usageMonth       Int
  createdAt        DateTime      @default(now())
  project          NovelProject? @relation(fields: [projectId], references: [id])
  user             User          @relation(fields: [userId], references: [id])

  @@index([userId, usageMonth])
  @@index([projectId])
  @@index([userId])
  @@index([createdAt])
  @@map("ai_usages")
}

model MarketTrend {
  id             String   @id @default(cuid())
  platform       String
  genre          String
  rankDate       DateTime
  avgWordCount   Int      @default(0)
  updateFreq     String?
  hotTags        String[] @default([])
  trendDirection String?
  analysisData   Json     @default("{}")
  createdAt      DateTime @default(now())

  @@index([platform, genre, rankDate])
  @@index([rankDate])
  @@map("market_trends")
}

model MarketBook {
  id           String   @id @default(cuid())
  platform     String
  genre        String
  title        String
  author       String?
  rankPosition Int?
  wordCount    Int      @default(0)
  rating       Float?
  tags         String[] @default([])
  synopsis     String?
  analysisData Json     @default("{}")
  rankDate     DateTime
  createdAt    DateTime @default(now())

  @@index([platform, genre])
  @@index([platform, rankDate])
  @@index([rankPosition])
  @@index([rankDate])
  @@map("market_books")
}

model ResearchRef {
  id                String       @id @default(cuid())
  projectId         Int
  topic             String
  summary           String
  keyFacts          String[]     @default([])
  creativeMaterials String[]     @default([])
  confidence        String       @default("medium")
  usageSuggestions  String[]     @default([])
  usedInChapter     Int?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  project           NovelProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("research_refs")
}

model CoverDesign {
  id          String       @id @default(cuid())
  projectId   Int
  imageUrl    String
  prompt      String
  colorScheme String[]     @default([])
  composition String?
  elements    String[]     @default([])
  mood        String?
  style       String?
  isApplied   Boolean      @default(false)
  createdAt   DateTime     @default(now())
  project     NovelProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("cover_designs")
}

model ReviewReport {
  id                  String       @id @default(cuid())
  projectId           Int
  chapterNo           Int?
  content             String
  reviews             Json         @default("[]")
  overallScore        Float        @default(0)
  consensus           String?
  criticalIssues      String[]     @default([])
  improvementPriority String[]     @default([])
  createdAt           DateTime     @default(now())
  project             NovelProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([projectId, chapterNo])
  @@map("review_reports")
}

model ShortStory {
  id               String              @id @default(cuid())
  projectId        Int                 @unique
  structure        String              @default("three_act")
  targetWordCount  Int                 @default(10000)
  currentWordCount Int                 @default(0)
  premise          String?
  emotionalDesign  Json?               @default("{}")
  reversalDesign   Json?               @default("{}")
  hookDesign       Json?               @default("{}")
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  project          NovelProject        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sections         ShortStorySection[]

  @@map("short_stories")
}

model ShortStorySection {
  id              String     @id @default(cuid())
  storyId         String
  sectionNumber   Int
  title           String
  content         String?
  wordCount       Int        @default(0)
  sectionType     String     @default("setup")
  emotionalTarget Int        @default(50)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  story           ShortStory @relation(fields: [storyId], references: [id], onDelete: Cascade)

  @@unique([storyId, sectionNumber])
  @@index([storyId])
  @@map("short_story_sections")
}

model GenerationJob {
  id             Int                  @id @default(autoincrement())
  projectId      Int
  type           String               @default("FULL_PIPELINE")
  status         JobStatus            @default(PENDING)
  currentStep    PipelineStep?
  stepIndex      Int                  @default(0)
  totalChapters  Int                  @default(0)
  currentChapter Int                  @default(0)
  retryCount     Int                  @default(0)
  maxRetries     Int                  @default(3)
  payload        Json?                @default("{}")
  result         Json?                @default("{}")
  errorMessage   String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  completedAt    DateTime?
  project        NovelProject         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  checkpoints    PipelineCheckpoint[]

  @@index([projectId])
  @@index([status])
  @@index([type])
  @@index([projectId, status])
  @@map("generation_jobs")
}

model ProjectMaintenanceTask {
  id           String       @id @default(cuid())
  projectId    Int
  taskType     String
  status       JobStatus    @default(PENDING)
  payload      Json?        @default("{}")
  result       Json?        @default("{}")
  errorMessage String?
  retryCount   Int          @default(0)
  maxRetries   Int          @default(3)
  priority     Int          @default(0)
  nextRunAt    DateTime?
  startedAt    DateTime?
  completedAt  DateTime?
  lockedAt     DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  project      NovelProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([status, nextRunAt, priority, createdAt])
  @@index([projectId, taskType, status])
  @@map("project_maintenance_tasks")
}

model PipelineCheckpoint {
  id        String        @id @default(cuid())
  jobId     Int
  step      PipelineStep
  input     Json?         @default("{}")
  output    Json?         @default("{}")
  error     String?
  status    String        @default("COMPLETED")
  createdAt DateTime      @default(now())
  job       GenerationJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
  @@index([jobId, step])
  @@map("pipeline_checkpoints")
}

model BookBlueprint {
  id                String       @id @default(cuid())
  projectId         Int          @unique
  corePitch         String
  worldDirection    String?
  mainlineDirection String?
  growthDirection   String?
  endingDirection   String?
  platformStrategy  String?
  genreStrategy     String?
  styleStrategy     String?
  popularFictionProfile Json?
  constraints       String[]     @default([])
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  project           NovelProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("book_blueprints")
}

model ArcPlan {
  id           String       @id @default(cuid())
  projectId    Int
  arcNumber    Int
  name         String
  stage        ArcStage
  description  String?
  batchSize    Int          @default(15)
  startChapter Int
  endChapter   Int?
  goals        String[]     @default([])
  keyEvents    String[]     @default([])
  isCompleted  Boolean      @default(false)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  project      NovelProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, arcNumber])
  @@index([projectId])
  @@map("arc_plans")
}

model ChapterCompletionReport {
  id                      String       @id @default(cuid())
  projectId               Int
  chapterNo               Int
  actualWordCount         Int
  targetWordCount         Int
  chapterGoalCompleted    Boolean      @default(false)
  mainConflictProgressed  Boolean      @default(false)
  mainConflictResolved    Boolean      @default(false)
  endingHookExists        Boolean      @default(false)
  abruptTruncationDetected Boolean     @default(false)
  completionScore         Int
  issues                  Json         @default("[]")
  createdAt               DateTime     @default(now())
  project                 NovelProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, chapterNo])
  @@index([projectId])
  @@index([projectId, completionScore])
  @@map("chapter_completion_reports")
}

model ArcEventLedger {
  id               String       @id @default(cuid())
  projectId        Int
  arcPlanId        String?
  arcNumber        Int?
  eventKey         String
  eventDescription String
  status           String       @default("pending")
  plannedChapterNo Int?
  actualChapterNo  Int?
  notes            String?
  metadata         Json         @default("{}")
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  project          NovelProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, eventKey])
  @@index([projectId, status])
  @@index([projectId, actualChapterNo])
  @@map("arc_event_ledger")
}

model CheatAbilityState {
  id                       String       @id @default(cuid())
  projectId                Int          @unique
  cheatName                String
  oneLineRule              String
  unlockedAbilities        Json         @default("[]")
  usageHistory             Json         @default("[]")
  currentMarkValue         Int          @default(0)
  currentBacklashValue     Int          @default(0)
  cooldownActiveUntilChapter Int?
  updatedAt                DateTime     @updatedAt
  createdAt                DateTime     @default(now())
  project                  NovelProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("cheat_ability_states")
}

model Villain {
  id           String       @id @default(cuid())
  projectId    Int
  name         String
  tier         String       @default("stage")
  isFinalBoss  Boolean      @default(false)
  arcNumber    Int?
  description  String?
  motivation   String?
  abilities    String[]     @default([])
  introducedAt Int?
  defeatedAt   Int?
  lifecycle    String?      @default("active")
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  project      NovelProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([arcNumber])
  @@index([tier])
  @@index([lifecycle])
  @@map("villains")
}

model WorldState {
  id                String       @id @default(cuid())
  projectId         Int          @unique
  mapLevel          Int          @default(1)
  factionCount      Int          @default(1)
  powerLevel        Int          @default(1)
  civilizationLevel Int          @default(1)
  classStructure    String[]     @default([])
  regions           String[]     @default([])
  currentExpansion  String?
  lastExpandedAt    DateTime?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  project           NovelProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("world_states")
}

