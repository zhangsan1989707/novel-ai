# 数据库连接配置
# 注意：如果使用 docker-compose.db.yml 启动数据库，端口为 5433；本地直连为 5432
DATABASE_URL="postgresql://novelai:password@localhost:5433/novel_ai?schema=public"

# NextAuth 配置
AUTH_SECRET="your-secret-key-here-change-in-production"
AUTH_URL="http://localhost:3200"
AUTH_GITHUB_ID="your-github-client-id"
AUTH_GITHUB_SECRET="your-github-client-secret"
AUTH_GOOGLE_ID="your-google-client-id"
AUTH_GOOGLE_SECRET="your-google-client-secret"

# AI API 配置
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_MODEL_ID=deepseek-chat

# RAG 向量化配置（建议单独配置 embedding 模型）
# OpenAI 示例：text-embedding-3-small / text-embedding-3-large
EMBEDDING_VENDOR=OPENAI
EMBEDDING_MODEL_ID=text-embedding-3-small
AI_EMBEDDING_DIMENSIONS=256
OPENAI_API_KEY=your-openai-api-key

# 火山方舟 Coding Plan / 豆包（OpenAI 兼容协议）
VOLCENGINE_API_KEY=your-volcengine-api-key
VOLCENGINE_MODEL_ID=ark-code-latest
VOLCENGINE_API_ENDPOINT=https://ark.cn-beijing.volces.com/api/coding/v3

# 智谱 AI (GLM)
ZHIPU_API_KEY=your-zhipu-api-key
ZHIPU_MODEL_ID=glm-4-0520
ZHIPU_API_ENDPOINT=https://open.bigmodel.cn/api/paas/v4

# 开发环境配置
NODE_TLS_REJECT_UNAUTHORIZED=0

# 默认 AI 配置
DEFAULT_AI_VENDOR=DEEPSEEK
DEFAULT_AI_MODEL_ID=deepseek-chat
DEFAULT_AI_API_KEY=your-deepseek-api-key
